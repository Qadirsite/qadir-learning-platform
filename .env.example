# Required: MySQL connection string
DATABASE_URL=mysql://qadir:change-me@mysql:3306/qadir

# Used only the first time the ak9 administrator account is created
INITIAL_ADMIN_PASSWORD=change-this-long-password

# Required for AI, speech, file upload and Manus Storage in the current build
MANUS_API_URL=https://your-manus-api.example
MANUS_API_KEY=replace-with-server-side-key

PORT=3000
NODE_ENV=production
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
FRAME_ANCESTORS='self'
TRUST_PROXY=auto
